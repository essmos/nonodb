[Unit]
Description=NonoDB outbox event consumer
After=nonodb.service
Requires=nonodb.service

[Service]
Type=simple
User=nonodb
Group=nonodb
Environment=NONODB_SOCK=/run/nonodb/nonodb.sock
Environment=PYTHONPATH=/opt/nonodb/client:/opt/nonodb/workers/python:/opt/nonodb/events
WorkingDirectory=/opt/nonodb
# Replace events_handlers and the consumer id for each independent consumer.
ExecStart=/usr/bin/python3 -m nonodb_worker.events_worker --module events_handlers --consumer-id order-sync
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nonodb /run/nonodb

[Install]
WantedBy=multi-user.target
