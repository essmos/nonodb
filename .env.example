# NonoDB environment template.
#
# Copy to `.env` and adjust for your host:
#   cp .env.example .env
#
# `.env` is ignored by git. Never commit tokens, private keys, certificates,
# vault keys, or auth registries.

# ---------------------------------------------------------------------------
# Instance and storage
# ---------------------------------------------------------------------------

# Instance root. Each database lives in <NONODB_DATA>/<database>/.
NONODB_DATA=./data

# Maximum simultaneously open LMDB environments/writers.
NONODB_MAX_OPEN_DATABASES=64

# LMDB address-space reservation. Accepts bytes, MiB, or GiB.
NONODB_MAP_SIZE=1GiB

# Tokio blocking threads used by LMDB reads and writes.
NONODB_BLOCKING_THREADS=64

# ---------------------------------------------------------------------------
# Listeners
# ---------------------------------------------------------------------------

# Unix socket used by local clients and the CLI.
NONODB_SOCK=/run/nonodb.sock

# Optional Unix socket uid/gid allow-lists (comma-separated).
# NONODB_ALLOWED_UIDS=1000,1001
# NONODB_ALLOWED_GIDS=1000

# TCP is optional and requires NONODB_AUTH_FILE.
# NONODB_TCP=127.0.0.1:7878

# TLS for the TCP listener. Provide both certificate and key, or neither.
# NONODB_TLS_CERT=/etc/nonodb/server.crt
# NONODB_TLS_KEY=/etc/nonodb/server.key

# Optional mutual TLS. When set, client certificates are verified against this
# CA bundle and their SHA-256 fingerprint must be registered in auth.json.
# NONODB_TLS_CLIENT_CA=/etc/nonodb/client-ca.crt
# NONODB_TLS_CLIENT_AUTH=required

# ---------------------------------------------------------------------------
# Authentication, audit, and lockout
# ---------------------------------------------------------------------------

# Required for TCP. Create it with:
#   nonodb-cli auth init
#   nonodb-cli auth token create admin
# NONODB_AUTH_FILE=/etc/nonodb/auth.json

# Failed-auth lockout. Set NONODB_AUTH_MAX_FAILURES=0 to disable.
# NONODB_AUTH_MAX_FAILURES=10
# NONODB_AUTH_FAILURE_WINDOW=60
# NONODB_AUTH_BLOCK_SECS=300

# Optional append-only JSONL audit log.
# NONODB_AUDIT_LOG=/var/log/nonodb/audit.jsonl
# NONODB_AUDIT_READS=0
# NONODB_AUDIT_FSYNC=0

# ---------------------------------------------------------------------------
# Durability and adaptive writer
# ---------------------------------------------------------------------------

# Enables per-request durability:"unsafe" using LMDB MDB_NOSYNC.
# NEVER enable this by default for payments, audit, auth, or vault data.
# NONODB_ALLOW_UNSAFE_WRITES=0

# Group-commit windows in microseconds.
# - IDLE: no other writes queued (fast path)
# - base: small backlog
# - PRESSURE: 64+ writes queued
# - MAX: 256+ writes queued
NONODB_WRITER_WINDOW_IDLE_US=100
NONODB_WRITER_WINDOW_US=1000
NONODB_WRITER_WINDOW_PRESSURE_US=3000
NONODB_WRITER_WINDOW_MAX_US=5000

# ---------------------------------------------------------------------------
# Timeouts and request limits
# ---------------------------------------------------------------------------

NONODB_REQUEST_TIMEOUT=30
NONODB_INDEX_TIMEOUT=3600
NONODB_AGGREGATE_MAX_DOCS=100000
NONODB_SQL_SLOW_MS=0
NONODB_DRAIN_TIMEOUT=30

# ---------------------------------------------------------------------------
# Worker parallelism
# ---------------------------------------------------------------------------

# Defaults are min(available CPUs, 16), capped at 256.
# NONODB_SCAN_WORKERS=8
# NONODB_BACKFILL_WORKERS=8
# NONODB_AGGREGATE_WORKERS=8

# ---------------------------------------------------------------------------
# Read cache
# ---------------------------------------------------------------------------

# Set NONODB_CACHE_TTL=0 to disable the read cache.
NONODB_CACHE_TTL=5
NONODB_CACHE_ENTRIES=512
NONODB_CACHE_MAX_BYTES=262144

# ---------------------------------------------------------------------------
# TTL, maintenance, and automatic indexes
# ---------------------------------------------------------------------------

NONODB_TTL_SWEEP_INTERVAL=5
NONODB_TTL_SWEEP_LIMIT=256
NONODB_MAINTENANCE_INTERVAL_MS=1000

# Automatic indexes are opt-in.
NONODB_AUTO_INDEX=0
NONODB_AUTO_INDEX_MIN_HITS=50
NONODB_AUTO_INDEX_WINDOW=300
NONODB_AUTO_INDEX_MIN_DOCS=10000
NONODB_AUTO_INDEX_MAX=8
NONODB_AUTO_INDEX_MAX_FIELDS=3
NONODB_AUTO_INDEX_TTL=604800
NONODB_AUTO_INDEX_MIN_AGE=3600
NONODB_AUTO_INDEX_INTERVAL=5

# ---------------------------------------------------------------------------
# Periodic snapshots
# ---------------------------------------------------------------------------

# Snapshots are written per database as
# <NONODB_SNAPSHOT_DIR>/<database>/data-<timestamp>.mdb
# NONODB_SNAPSHOT_DIR=/var/backups/nonodb/snapshots
# NONODB_SNAPSHOT_INTERVAL=300
# NONODB_SNAPSHOT_KEEP=24

# ---------------------------------------------------------------------------
# Scheduled backups
# ---------------------------------------------------------------------------

# Job configuration and runtime state. Defaults to <NONODB_DATA>/backups.json.
# NONODB_BACKUP_CONFIG=/etc/nonodb/backups.json

# Temporary consistent-copy + encryption staging. Must have room for one
# compacted database copy.
# NONODB_BACKUP_STAGING=/var/lib/nonodb/.backup-staging

# Scheduler polling interval in seconds.
# NONODB_BACKUP_SCHEDULER_INTERVAL=15

# Required only for restoring an encrypted backup. Keep it outside the daemon.
# NONODB_BACKUP_IDENTITY_FILE=/etc/nonodb/backup-identity.txt

# Restic engine: install restic on the host (the Docker image includes it).
# Restic jobs reference their repository, password file, and binary in backups.json.
# AWS_DEFAULT_REGION=auto

# Backup key files (age identity/recipient and generated restic password).
# Defaults to <NONODB_DATA>/backup-keys and is created with mode 0700.
# NONODB_BACKUP_KEY_DIR=/var/lib/nonodb/backup-keys

# Allowed local roots for the GUI Import wizard (path-list, ':' on Unix).
# Defaults to <NONODB_DATA>/backups.
# NONODB_IMPORT_ROOTS=/var/lib/nonodb/backups:/var/backups/nonodb

# S3/R2 credentials are referenced by env-var names in backups.json.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# text or json
NONODB_LOG_FORMAT=text

# tracing filter
RUST_LOG=info,nonodb=debug

# ---------------------------------------------------------------------------
# Client defaults (Python, Rust, Node.js, Go, CLI)
# ---------------------------------------------------------------------------

# NONODB_URL=http://127.0.0.1:7878
# NONODB_TOKEN=
# NONODB_DB=default

# Client request timeout in seconds.
# NONODB_TIMEOUT=10

# Client TLS verification. Never disable in production.
# NONODB_TLS_VERIFY=1
# NONODB_TLS_CA=/etc/nonodb/ca.crt
# NONODB_TLS_CLIENT_CERT=/etc/nonodb/client.crt
# NONODB_TLS_CLIENT_KEY=/etc/nonodb/client.key

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------

# Pin a published image tag instead of using latest.
# NONODB_IMAGE=ghcr.io/essmos/nonodb:0.22.0

# ---------------------------------------------------------------------------
# Optional worker examples
# ---------------------------------------------------------------------------

# NONODB_JOBS_COLLECTION=_jobs
